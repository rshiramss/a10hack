# Copy to .env and fill in. Never commit .env.
# HS256 key for badges. At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
BADGE_SIGNING_KEY=
# Only needed for `--live` (an LLM drives the agents).
# ollama (default): local model via Ollama. `ollama pull qwen2.5:3b` first.
# openai: any OpenAI-compatible API, e.g. Groq:
#   BADGE_LLM_BASE_URL=https://api.groq.com/openai/v1  BADGE_MODEL=llama-3.1-8b-instant
# anthropic: Claude (`uv sync --extra anthropic`, set ANTHROPIC_API_KEY).
BADGE_LLM_PROVIDER=ollama
BADGE_MODEL=qwen2.5:3b
BADGE_LLM_BASE_URL=
BADGE_LLM_API_KEY=
ANTHROPIC_API_KEY=
# Demo-grade monitor logins for the dashboard: user:password,user:password
MONITOR_PASSWORDS=alice:change-me-1,bob:change-me-2
# SQLite file the gateway uses.
BADGE_DB=data/badge.db
